{
  "name": "soiree",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:secrets": "node --experimental-strip-types scripts/check-secrets.ts",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.16.0",
    "next": "16.4.3",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5",
    "prettier": "^3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}
